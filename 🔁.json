{
    "enhConfig": {
        "enhKey": "🔁",
        "spawn": "three-peat/three-peat.js",
        "withAttrs": {
            "base": "🔁",
            "listProp": "${base}-list-prop",
            "src": "${base}-src",
            "each": "${base}-each",
            "_each": {
                "instanceOf": "Object"
            },
            "target": "${base}-target",
            "updateOn": "${base}-update-on"
        }
    },
    "customData": {
        "weakRef": {
            "properties": [
                "enhancedElement"
            ]
        },
        "actions": {
            "hydrate": {
                "ifKeyIn": [
                    "src",
                    "listProp"
                ],
                "ifAllOf": [
                    "enhancedElement"
                ]
            }
        }
    }
}